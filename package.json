{
  "name": "dsh-web-mobile-pmsfh",
  "version": "3.4.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.1 <0.2.3-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renlang119/dsh-web-mobile-pmsfh.git"
  },
  "description": "A standalone mobile page for DeepSeek Harness with conversations, attachments, approvals and workspace file browsing. Desktop UI untouched.",
  "files": [
    "lib/",
    "client/",
    "mobile/",
    "cordis.patch.yml",
    "types.d.ts",
    "README.md",
    "README.en.md"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./types.d.ts": "./types.d.ts",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test",
    "test:cov": "npm run test:cov:core && npm run test:cov:app",
    "test:cov:core": "node --experimental-test-coverage --test-coverage-include=\"lib/**/*.js\" --test-coverage-include=\"client/**/*.js\" --test-coverage-lines=96 --test-coverage-branches=86 --test-coverage-functions=92 --test",
    "test:cov:app": "node --experimental-test-coverage --test-coverage-include=\"mobile/app.js\" --test-coverage-lines=58 --test-coverage-branches=47 --test-coverage-functions=56 --test test/dom-smoke.test.mjs",
    "e2e:smoke": "node tools/e2e/release-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "stylelint": "^18.1.0",
    "typescript": "^7.0.2"
  }
}
