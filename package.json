{
  "name": "dsh-web-mobile-pmsfh",
  "version": "3.2.5",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renlang119/dsh-web-mobile-pmsfh.git"
  },
  "description": "Mobile-first standalone page for DeepSeek Harness (DSH): a self-contained chat UI at /dsh-web-mobile-pmsfh/ speaking DSH's remote protocol, with chat attachments and workspace file browse/download via official APIs. Desktop UI untouched, zero core changes.",
  "files": [
    "lib/",
    "client/",
    "mobile/",
    "cordis.patch.yml",
    "types.d.ts",
    "README.md",
    "README.en.md"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  }
}
